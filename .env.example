# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/websitetester
DATABASE_SYNC_URL=postgresql://postgres:postgrespassword@localhost:5432/websitetester

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI Diagnostics (Gemini API Key)
AI_API_KEY=
AI_MODEL=gemini-1.5-pro

# Security & Crawl Limits
ALLOW_INTERNAL_NETWORKS=false
ALLOW_LOCALHOST_TESTING=true
LOCALHOST_HOST=localhost
LOCALHOST_TIMEOUT=30000
MAX_PAGES_LIMIT=100
DEFAULT_TIMEOUT_MS=30000

# Form submission safety mode (validation_only | synthetic_submit)
ENABLE_FORM_SUBMISSION=false
FORM_SUBMISSION_MODE=validation_only

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./storage
